{
  "manifest_version": 3,
  "name": "Ocultar Cursor em Tela Cheia",
  "short_name": "Ocultar cursor",
  "version": "1.2.2",
  "description": "Oculta o cursor após quatro segundos sem atividade em players de tela cheia nos sites que você autorizar.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "lib/hosts.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Configurar sites",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cursor-em-tela-cheia@local",
      "strict_min_version": "109.0"
    }
  }
}

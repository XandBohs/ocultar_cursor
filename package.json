{
  "name": "cursor-em-tela-cheia",
  "version": "1.2.2",
  "private": true,
  "description": "Extensão que oculta o cursor após quatro segundos de inatividade em players de tela cheia autorizados.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "npm run check && node scripts/release.mjs",
    "screenshots": "node scripts/capture-store-screenshots.mjs",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
